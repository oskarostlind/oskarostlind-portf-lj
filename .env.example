# ---------------------------------------------------------------------------
# Kopiera denna fil till .env.local för lokal körning.
# Samma variabler läggs in i Vercel: Project → Settings → Environment Variables
# (Production, Preview och Development).
# ---------------------------------------------------------------------------

# SMTP via Stratos mejlkonto info@oskarostlind.se (MX/SPF/DMARC pekar redan dit).
# SMTP_PASS = lösenordet för mejlkontot info@ i Strato. DMARC är p=reject, så
# formuläret MÅSTE skicka via Strato — inte via Gmail — om avsändaren är @oskarostlind.se.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@oskarostlind.se
SMTP_PASS=
CONTACT_TO=info@oskarostlind.se

# Publik bas-URL — används för sitemap, canonical, hreflang och OG-bilder.
# Lokalt: http://localhost:3000
# Vercel (produktion): https://oskarostlind.se
NEXT_PUBLIC_SITE_URL=https://oskarostlind.se
