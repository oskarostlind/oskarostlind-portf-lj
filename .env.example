# ---------------------------------------------------------------------------
# Kopiera denna fil till .env.local för lokal körning.
# Samma variabler läggs in i Vercel: Project → Settings → Environment Variables
# (Production, Preview och Development).
# ---------------------------------------------------------------------------

# Gmail SMTP — skapa ett app-lösenord på https://myaccount.google.com/apppasswords
# Använd app-lösenordet, inte ditt vanliga Google-lösenord. Utan mellanslag.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=oskarandreassen01@gmail.com
SMTP_PASS=
CONTACT_TO=oskarandreassen01@gmail.com

# Publik bas-URL — används för sitemap, canonical, hreflang och OG-bilder.
# Lokalt: http://localhost:3000
# Vercel (produktion): https://oskarostlind.se
NEXT_PUBLIC_SITE_URL=https://oskarostlind.se
